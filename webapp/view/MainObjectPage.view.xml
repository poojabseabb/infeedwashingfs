<mvc:View controllerName="com.ewm.infeedwashingfs.controller.MainObjectPage"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:ndc="sap.ndc"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:layout="sap.ui.layout"
	xmlns="sap.m"
    height="100%">
	<f:DynamicPage
        id="page"
        preserveHeaderStateOnScroll="true"
        headerExpanded="true"
        showFooter="true"
        fitContent="true"
    >
		<!-- ===================================================== -->
		<!-- DYNAMIC PAGE TITLE -->
		<!-- ===================================================== -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>WashingInfeedStationNew}" />
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<!-- ===================================================== -->
		<!-- DYNAMIC PAGE HEADER -->
		<!-- ===================================================== -->
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<Panel
					backgroundDesign="Transparent"
					class="sapUiNoContentPadding"
                    >
					<content>
						<layout:HorizontalLayout allowWrapping="true">
						<!-- ===================================================== -->
						<!-- HEADER INFO -->
						<!-- ===================================================== -->
							<layout:VerticalLayout
                                        class="sapUiMediumMarginEnd"
                                    >
								<!-- Work Center -->
								<HBox
                                    alignItems="Center"
                                    class="sapUiTinyMarginBottom">
 
                                    <ObjectAttribute
                                        id="txtWCScannerResult"
                                        title="{i18n>WorkCenter}"
                                        text="{viewModel>/Workcenter}"
                                        class="sapUiTinyMarginEnd" 
										/>
 
                                    <ndc:BarcodeScannerButton
                                        id="btnWCBarcode"
                                        scanSuccess=".onWorkCenterScanSuccess"
                                        scanFail=".onScanError"
                                        inputLiveUpdate=".onWorkCenterLiveUpdate"
                                        dialogTitle="Scan Work Center" />
                                </HBox>

								<!-- Pallet Number -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiTinyMarginBottom">
 
                                    <Label
                                        text="{i18n>PalletNumber}"
                                        width="5rem" />
 
                                    <Input
                                        id="palletInput"
                                        value="{viewModel>/Palletnumber}"
                                        editable="{viewModel>/palletEditable}"
                                        enabled="{viewModel>/palletEnabled}"
                                        width="12rem"
                                        submit=".onPalletSubmit" /> 
                                </HBox>
							</layout:VerticalLayout>

							<!-- ================================= -->
							<!-- SOURCE HU SCANNER -->
							<!-- ================================= -->
 
                            <layout:VerticalLayout visible="{viewModel>/sourceHUVisible}">
 
                                <Label
                                    text="{i18n>SourceHUHead}"
                                    class="sapUiTinyMarginBottom" />
 
                                <ndc:BarcodeScannerButton
                                    id="btnHUBarcode"
                                    scanSuccess=".onSourceHUScanSuccess"
                                    scanFail=".onScanError"
                                    inputLiveUpdate=".onScanLiveupdate"
                                    dialogTitle="Scan Source HU"
									visible="{viewModel>/sourceHUVisible}"
                                     />
 
                            </layout:VerticalLayout>
						</layout:HorizontalLayout>
					</content>
				</Panel>
			</f:DynamicPageHeader>
		</f:header>
		
		<!-- ===================================================== -->
		<!-- DYNAMIC PRODUCTS TABLE-->
		<!-- ===================================================== -->
		<f:content>
			<t:Table
                id="productTable"
                rows="{viewModel>/ProductCollection}"
                selectionMode="MultiToggle"
                rowMode="Auto"
                visible="{viewModel>/tableVisible}">
				<!-- ============================================= -->
				<!-- TABLE TOOLBAR -->
				<!-- ============================================= -->
 
                <t:extension>
                    <OverflowToolbar style="Clear">
                        <Title text="{i18n>Products}" />
                        <ToolbarSpacer />

						<ndc:BarcodeScannerButton
                            id="btnHUToolbar"
							scanSuccess=".onSourceHUScanSuccess"
                            scanFail=".onScanError"
                            inputLiveUpdate=".onScanLiveupdate"
                            dialogTitle="Scan Source HU"
							visible="{viewModel>/sourceHUVisible}"
                            />
                    </OverflowToolbar> 
                </t:extension>

 				<!-- ============================================= -->
				<!-- TABLE COLUMNS -->
				<!-- ============================================= -->
				<t:columns>
					<t:Column width="11rem">
						<Label text="{i18n>SourceHU}" />
						<t:template>
							<Text
                                text="{viewModel>Sourcehu}"
                                wrapping="false"
                            />
						</t:template>
					</t:Column>
					<t:Column width="11rem">
						<Label text="{i18n>Materials}" />
						<t:template>
							<Text
                                text="{viewModel>Material}"
                                wrapping="false"
                            />
						</t:template>
					</t:Column>
					<t:Column width="11rem">
						<Label text="{i18n>Description}" />
						<t:template>
							<Text
                                text="{viewModel>Itemdesc}"
                                wrapping="false"
                            />
						</t:template>
					</t:Column>
					<t:Column width="11rem">
						<Label text="{i18n>LiftingTool}" />
						<t:template>
							<Text
                                text="{viewModel>Liftingtool}"
                                wrapping="false"
                            />
						</t:template>
					</t:Column>
					<t:Column
                        width="6rem"
                        hAlign="End"
                    >
						<Label text="{i18n>QuantityInPallet}" />
						<t:template>
							<Text
                                text="{viewModel>QuantityInPal}"
                                wrapping="false"
                            />
						</t:template>
					</t:Column>
					<t:Column width="9rem">
						<Label text="{i18n>QuantityRequired}" />
						<t:template>
							<Text
                                text="{viewModel>QuantityReq}"
                                wrapping="false"
                            />
						</t:template>
					</t:Column>
					<t:Column width="9rem">
						<Label text="{i18n>QuantityRemaining}" />
						<t:template>
							<Text
                                text="{viewModel>QuantityRem}"
                                wrapping="false"
                            />
						</t:template>
					</t:Column>
					<t:Column width="12rem">
						<Label text="{i18n>QuantityLoaded}" />
						<t:template>
							<Input value="{viewModel>QuantityLoaded}" type="Number"/>
						</t:template>
					</t:Column>
					<t:Column width="9rem">
						<Label text="{i18n>ConfirmDelivery}" />
						<t:template>
							<Button
                                text="{i18n>ConfirmDelivery}"
								type="Emphasized"
                                press=".handleDetailsPress"
								visible="{viewModel>ConfirmVisible}"
								enabled="{viewModel>ConfirmEnabled}"
                            />
						</t:template>
					</t:Column>
					<t:Column width="9rem">
						<Label text="{i18n>WorkInstruction}" />
						<t:template>
							<Link
                                text="Instructions"
                                href="{viewModel>WorkInstruction}"
                                target="_blank"
                            />
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>